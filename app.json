{
  "expo": {
    "name": "Frencia",
    "slug": "frencia",
    "owner": "bauribotta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-light.png",
    "scheme": "frencia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/app-icon-light.png",
        "dark": "./assets/images/app-icon-dark.png"
      },
      "bundleIdentifier": "com.frencia.fitness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frencia.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#F9F9F9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E4E7E4",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#161317",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Frencia necesita acceso a tus fotos para elegir tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7d53930-7265-47af-adcd-fb21748689d2"
      }
    }
  }
}
